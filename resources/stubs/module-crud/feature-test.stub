<?php

namespace {{ namespace }}\Tests\Feature;

use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;
use {{ namespace }}\App\Models\{{ module }};

class {{ module }}ControllerTest extends TestCase
{
    use RefreshDatabase;

    public function test_can_create_{{ module_lower }}(): void
    {
        $response = $this->postJson(
            '/api/{{ route_prefix }}',
            [
                {{ factory_fields }}
            ]
        );

        $response
            ->assertStatus(201)
            ->assertJson([
                'success' => true,
            ]);
    }

    public function test_can_get_{{ module_lower }}_list(): void
    {
        {{ module }}::factory()->count(3)->create();

        $response = $this->getJson(
            '/api/{{ route_prefix }}'
        );

        $response->assertOk();
    }

    public function test_can_get_single_{{ module_lower }}(): void
    {
        $model = {{ module }}::factory()->create();

        $response = $this->getJson(
            "/api/{{ route_prefix }}/{$model->id}"
        );

        $response->assertOk();
    }

    public function test_can_delete_{{ module_lower }}(): void
    {
        $model = {{ module }}::factory()->create();

        $response = $this->deleteJson(
            "/api/{{ route_prefix }}/{$model->id}"
        );

        $response->assertOk();

        $this->assertDatabaseMissing(
            '{{ table }}',
            [
                'id' => $model->id,
            ]
        );
    }
}
