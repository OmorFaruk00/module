<?php

namespace {{ namespace }}\App\Repositories;

use {{ namespace }}\App\Models\{{ module }};
use {{ namespace }}\App\Repositories\Contracts\{{ module }}RepositoryInterface;

class {{ module }}Repository implements {{ module }}RepositoryInterface
{
    public function __construct(
        protected {{ module }} $model
    ) {}

    public function all()
    {
        return $this->model
            ->latest()
            ->paginate(15);
    }

    public function findOrFail(int $id)
    {
        return $this->model->findOrFail($id);
    }

    public function create(array $data)
    {
        return $this->model->create($data);
    }

    public function update(int $id, array $data)
    {
        $model = $this->findOrFail($id);

        $model->update($data);

        return $model->fresh();
    }

    public function delete(int $id)
    {
        $model = $this->findOrFail($id);

        return $model->delete();
    }
}
