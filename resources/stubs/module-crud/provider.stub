<?php

namespace {{ namespace }}\Providers;

use Illuminate\Support\ServiceProvider;
use {{ namespace }}\App\Repositories\{{ module }}Repository;
use {{ namespace }}\App\Repositories\Contracts\{{ module }}RepositoryInterface;

class {{ module }}ServiceProvider extends ServiceProvider
{
    public function register(): void
    {
        $this->app->bind(
            {{ module }}RepositoryInterface::class,
            {{ module }}Repository::class
        );
    }

    public function boot(): void
    {
        $this->loadRoutesFrom(
            base_path(
                'Modules/{{ module }}/routes/api.php'
            )
        );

        $this->loadMigrationsFrom(
            base_path(
                'Modules/{{ module }}/Database/migrations'
            )
        );
    }
}
